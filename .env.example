# Compose principal (raiz). Preserve as credenciais do banco ja existente.
POSTGRES_USER=sidpb_admin
POSTGRES_PASSWORD=substitua-pela-senha-do-banco-existente
POSTGRES_DB=sidpb_db
REGIOES_SHP=/base_geografica/shapefiles_ibge/BR_Regioes/BR_Regioes_2025.shp
ESTADOS_SHP=/base_geografica/shapefiles_ibge/BR_UF/BR_UF_2025.shp
MUNICIPIOS_SHP=/base_geografica/shapefiles_ibge/BR_Municipios/BR_Municipios_2025.shp
TRANSFORMACAO_STG_TO_DB=/base_geografica/sql/InsercaoBaseIbge.sql

# Apenas desenvolvimento local; substitua os exemplos por senhas distintas.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=substitua-por-uma-senha-local-forte
KEYCLOAK_DB_USER=sidpb_keycloak
KEYCLOAK_DB_PASSWORD=substitua-por-outra-senha-local-forte

# Etapa 3: segredos de clientes distintos; somente no servidor.
KEYCLOAK_WEB_SECRET=preencha-com-o-segredo-do-cliente-sidpb-web
KEYCLOAK_API_SECRET=preencha-com-o-segredo-do-cliente-sidpb-api
KEYCLOAK_SERVICE_SECRET=preencha-com-o-segredo-do-cliente-sidpb-admin-service
# Gere 32 bytes aleatorios em base64; nao troque sem encerrar as sessoes locais.
AUTH_SESSION_KEY=preencha-com-32-bytes-aleatorios-em-base64

# Enderecos publicos canonicos (sem barra final); unica fonte por ambiente.
AUTH_ORIGIN=http://localhost:7080
NEXT_PUBLIC_BASE_PATH=/sidpb
API_PUBLIC_URL=http://localhost:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8081
AUTH_ALLOW_HTTP=true
ACCOUNT_RECONCILIATION_ENABLED=true
AUTH_SESSION_MAINTENANCE_ENABLED=true
